# 천명(天命) 배포용 환경변수 템플릿
# 실제 운영/로컬 실행 시 이 파일을 .env 로 복사하거나 배포 플랫폼(Railway/Render/AWS 등)의
# Environment Variables 메뉴에 아래 값을 직접 입력하세요. (.env 파일은 Git에 커밋되지 않습니다.)

# 서버 포트 (클라우드 플랫폼에서는 자동 주입됨)
PORT=8085

# Spring 실행 프로필 (로컬: default / 운영: prod)
SPRING_PROFILES_ACTIVE=prod

# MySQL 8.x 데이터베이스 연결 정보
DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/chunmyung_saju?useSSL=true&serverTimezone=Asia/Seoul
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# 최고 관리자 계정 (미설정 시 자동 생성하지 않음)
ADMIN_ID=CHANGE_ME_ADMIN_ID
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# 허용할 프론트엔드 Origin (쉼표로 복수 지정 가능)
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Swagger API 문서 노출 여부 (운영 환경은 false 권장)
SPRINGDOC_ENABLED=false
